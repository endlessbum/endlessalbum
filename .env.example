# Example environment variables for local development
# Copy to .env and adjust values.

# PostgreSQL connection string (leave empty to use in-memory MemStorage in dev)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Database TLS ---
# TLS is enabled and the server certificate is VERIFIED by default (secure).
# Managed providers (Render, Supabase, RDS, …) usually sign the DB cert with a
# private CA — supply that CA so verification succeeds:
#   DATABASE_CA_CERT_FILE=/path/to/ca.pem      # path to a PEM file
#   DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"  # inline PEM (\n allowed)
#
# Escape hatches (weaken security — use only when you must):
#   DATABASE_SSL=disable                        # connect without TLS (local/private network)
#   DATABASE_SSL_REJECT_UNAUTHORIZED=false      # keep TLS but skip verification (INSECURE, MITM-prone)

# Session secret for express-session (use a long random string)
SESSION_SECRET=dev_secret_change_me

# Public origin of the app (used for cookies/callbacks)
APP_ORIGIN=http://127.0.0.1:5000

# Server port (dev picks next free if busy)
PORT=5000
